# Copy to .env; all secrets below must be generated separately. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/devrelay
APP_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173
SESSION_SECRET=replace-with-random-64-character-secret
ENCRYPTION_KEY=replace-with-64-hex-characters-from-32-random-bytes
# EMAIL_MODE=console ONLY in development; production requires a real rail:
# EMAIL_MODE=smtp (SMTP_HOST + EMAIL_FROM) or mailtrap (MAILTRAP_API_TOKEN + MAILTRAP_FROM_EMAIL).
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Mailtrap Email API rail (EMAIL_MODE=mailtrap). Token: https://mailtrap.io/settings/api-tokens
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=
MAILTRAP_FROM_NAME=DevRelay
# Sandbox testing needs no verified sending domain (development/preview only).
MAILTRAP_USE_SANDBOX=false
# MAILTRAP_INBOX_ID=1400001  <- uncomment and fill only with MAILTRAP_USE_SANDBOX=true
SUPPORT_EMAIL=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Comma-separated signing secrets for zero-downtime webhook rotation.
PAYSTACK_WEBHOOK_SECRETS=
AT_USERNAME=
AT_API_KEY=
AT_MODE=sandbox
AT_CALLBACK_TOKEN=
# Alternative SMS rail (https://aigh.dev/api/v1). SMS_PROVIDER=aigh switches the
# worker to AIGH; SMS availability then requires only AIGH_API_KEY. The send
# path is provisional until AIGH publishes its full SMS reference, and delivery
# callbacks are not wired yet (see docs/providers.md).
SMS_PROVIDER=africastalking
AIGH_API_KEY=
AIGH_BASE_URL=https://aigh.dev/api/v1
# SIM-gateway rail (https://github.com/capcom6/android-sms-gateway on a spare
# Android phone). SMS_PROVIDER=sim-gateway switches the worker to it; sends need
# GATEWAY_URL (the app's Local Server URL, e.g. http://192.168.1.20:8080) plus
# its Basic credentials. The device's SIM number is the sender — no approved
# sender ID. GATEWAY_WEBHOOK_SECRET (the app's webhook signing key) enables
# delivery callbacks on POST /api/webhooks/sms-gateway.
GATEWAY_URL=
GATEWAY_USER=
GATEWAY_PASSWORD=
GATEWAY_SIM_NUMBER=
GATEWAY_WEBHOOK_SECRET=
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v27.0
META_VERIFY_TOKEN=
# Only set true after required Meta approvals, business verification and live billing setup.
META_PRODUCTION_APPROVED=false
WORKER_POLL_MS=1500
